fn check_syntax(){
let proposal={}
let submitted=false
fn decide(decision){
 if submitted {return}
 let pending=try {fs.read("accounts/device/pending-proposal.json").parse_json()} catch {nil}
 let current=try {fs.read("accounts/device/state.json").parse_json()} catch {nil}
 let valid=try {pending.id==proposal.id && time_now()<=pending.expires_at && current.last_sequence==pending.base_sequence} catch {false}
 if !valid {ui.result.set_text("这张卡片已过期，请回到应用重新整理。"); return}
 let result=fs.write("accounts/device/confirmed-action.json",{proposal_id:proposal.id,decision:decision}.to_json())
 if result!=nil {ui.result.set_text("未能保存确认操作，请重试。"); return}
 submitted=true
 if decision=="confirm" {ui.result.set_text("已确认。保持 TrendyHear 打开，应用将保存并执行。")}
 else {ui.result.set_text("已取消，偏好不会修改。")}
}
SolidView{width:Fill height:Fit flow:Down padding:16 spacing:10 draw_bg.color:#xfff8ec
 Label{width:Fill text:"确认阅读偏好" draw_text.color:#x20312c draw_text.text_style.font_size:22}
 Label{width:Fill text:proposal.title draw_text.color:#x20312c}
 Label{width:Fill text:"主题优先级："+proposal.topics draw_text.color:#x20312c}
 Label{width:Fill text:"用途："+proposal.purpose draw_text.color:#x697970}
 Label{width:Fill text:"每日时间："+proposal.time+" · "+proposal.enabled draw_text.color:#x697970}
 Label{width:Fill text:"我的理解："+proposal.interpretation draw_text.color:#x20312c}
 Label{width:Fill text:"确认订阅或单次查询后立即生成。定时与延后提醒仅在应用打开时执行。" draw_text.color:#x697970}
 View{width:Fill height:Fit flow:Right spacing:12
  ButtonFlat{text:"确认保存" on_click:|| decide("confirm") draw_text +:{color:#x20312c color_hover:#x20312c color_down:#x20312c color_focus:#x20312c}}
  ButtonFlat{text:"取消" on_click:|| decide("cancel") draw_text +:{color:#x20312c color_hover:#x20312c color_down:#x20312c color_focus:#x20312c}}
 }
 result:=Label{width:Fill text:"核对无误再确认；需要调整请继续在 Ask 面板告诉听见顾问。" draw_text.color:#x697970}
}

}
